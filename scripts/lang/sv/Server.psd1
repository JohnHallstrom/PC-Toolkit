# Swedish texts for ReportServer.ps1 (theme: Sparkollen). Key = English text, value = Swedish text.
@{
    'The token must be at least 16 letters or digits.' = 'Token måste bestå av minst 16 bokstäver eller siffror.'
    'The repair step ended unexpectedly. See repair-log in the report folder.' = 'Träningspasset avbröts oväntat. Se repair-log (Förarens anteckningar) i mappen med domarprotokollet.'
    'Repairs are blocked because drive health is uncertain. Back up important files first.' = 'Reparationerna är stoppade eftersom det är osäkert om disken mår bra. Säkerhetskopiera viktiga filer först.'
    'PC Toolkit does not have administrator permission. Close it, start it again and click Yes when Windows asks.' = 'PC Toolkit har inte administratörsbehörighet. Stäng programmet, starta det igen och klicka Ja när Windows frågar.'
    'A repair is already running.' = 'Ett träningspass pågår redan.'
    'Invalid selection.' = 'Ogiltigt val.'
    '{0} Repairs started from the report ({1} selected).' = '{0} Träningspasset startade från domarprotokollet ({1} valda).'
    'Not found' = 'Hittades inte'
    'Forbidden' = 'Åtkomst nekad'
    'Method not allowed' = 'Metoden är inte tillåten'
    'Too large' = 'För stor förfrågan'
    'Wait until the repairs have finished.' = 'Vänta tills träningspasset är klart.'
    'PC Toolkit: the computer restarts in 30 seconds. Save your work.' = 'PC Toolkit: datorn startas om om 30 sekunder. Spara det du arbetar med.'
    '{0} Restart requested from the report.' = '{0} Omstart begärd från domarprotokollet.'
    'Open the address below in a web browser on this computer.' = 'Öppna adressen nedan i en webbläsare på den här datorn.'
    'The report is opening in your web browser.' = 'Domarprotokollet öppnas i din webbläsare.'
    'Choose what to fix there and click "Fix selected".' = 'Välj där vad som ska fixas och klicka på knappen för att fixa det valda.'
    'Keep this window open while you use the report. It closes when you click "Finish" in the report.' = 'Låt det här fönstret vara öppet medan du använder domarprotokollet. Det stängs när du klickar på knappen för att avsluta i domarprotokollet.'
    'DRY RUN: repairs started from the report will not change anything.' = 'TESTLÄGE: träningspass som startas från domarprotokollet ändrar ingenting.'
    'Address (only works on this computer): {0}' = 'Adress (fungerar bara på den här datorn): {0}'
    'No activity from the report for a while; closing.' = 'Ingen aktivitet från domarprotokollet på ett tag – stänger.'
    'PC Toolkit has finished. This window can be closed.' = 'PC Toolkit är klart. Du kan stänga det här fönstret.'
}
