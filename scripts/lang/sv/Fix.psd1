# Swedish texts for the fix panel in the report (report-fix.js, theme: Sparkollen). Key = English text, value = Swedish text.
# Get-StringTable sends only this file to the browser, so tags shared with Repair.psd1 are repeated here.
@{
    'Recommended' = 'Grundträning (rekommenderas)'
    'Safe changes that help most computers. A restore point is created first, so everything can be undone.' = 'Säkra ändringar som hjälper de flesta datorer. En återställningspunkt skapas först, så allt går att ångra.'
    'Stop apps from starting with Windows' = 'Stoppa program som startar med Windows'
    'The apps still work when you open them yourself. Pre-selected apps are rarely needed at startup. Unsure about an app? Leave it unticked.' = 'Programmen fungerar fortfarande när du öppnar dem själv. Förvalda program behövs sällan vid start. Osäker på ett program? Lämna det okryssat.'
    'Remove unwanted programs' = 'Ta bort oönskade program'
    'An uninstall window opens for each program. Follow its steps.' = 'Ett avinstallationsfönster öppnas för varje program. Följ stegen i det.'
    'Optional extras' = 'Extraövningar'
    'Only if you want them.' = 'Bara om du vill.'
    'Keep' = 'Behåll'
    'Can be disabled' = 'Kan stängas av'
    'Optional' = 'Valfri'
    'Error {0}' = 'Fel {0}'
    'Fix selected ({0})' = 'Sök! – Åtgärda valda ({0})'
    'Select something to fix' = 'Välj något att åtgärda'
    'This is a saved copy of the report, so nothing can be fixed from here. To fix problems, double-click "Starta Spårkollen" in the PC Toolkit folder.' = 'Det här är en sparad kopia av rapporten, så inget kan åtgärdas härifrån. Dubbelklicka på "Starta Spårkollen" i mappen för att åtgärda problem.'
    'PC Toolkit was not given administrator permission, so it cannot fix anything. Close the PC Toolkit window, start it again and click Yes when Windows asks.' = 'Spårkollen fick inte administratörsbehörighet och kan därför inte åtgärda något. Stäng Spårkollen-fönstret, starta igen och klicka Ja när Windows frågar.'
    'Test mode: nothing will actually be changed.' = 'Testläge: ingenting ändras på riktigt.'
    'Select suggested' = 'Välj förslagen'
    'Select none' = 'Välj inga'
    'Fix selected' = 'Sök! – Åtgärda valda'
    'Close games and save your work first. You can follow the progress here.' = 'Stäng spel och spara ditt arbete först. Du kan följa spåret här.'
    'Close without fixing' = 'Avsluta utan att åtgärda'
    'Fix the {0} selected item(s) now?' = 'Åtgärda {0} valda saker nu?'
    'A restore point is created first. Close games and save your work.' = 'En återställningspunkt skapas först. Stäng spel och spara ditt arbete.'
    'Fixing problems...' = 'Spårar...'
    'Fixing problems... ({0})' = 'Spårar... ({0})'
    'Do not turn off the computer. Uninstall windows may open; follow their steps. Some steps take a long time without visible progress.' = 'Stäng inte av datorn. Avinstallationsfönster kan öppnas – följ stegen i dem. Vissa steg tar lång tid utan att något syns.'
    '{0} min {1} s' = '{0} min {1} s'
    '{0} s' = '{0} s'
    'Lost contact with PC Toolkit. Is its window still open?' = 'Tappade kontakten med Spårkollen. Är fönstret fortfarande öppet?'
    'Test run finished - nothing was changed' = 'Provspåret klart – ingenting ändrades'
    'Done!' = 'Bra jobbat!'
    'What was done' = 'Det här gjordes'
    'Would be done (test mode)' = 'Skulle ha gjorts (testläge)'
    'Skipped' = 'Hoppades över'
    'Things to do yourself' = 'Att göra själv'
    'Restart the computer to finish. Choose Restart, not Shut down. Run PC Toolkit again afterwards to see the difference.' = 'Starta om datorn för att bli klar. Välj Starta om, inte Stäng av. Kör Spårkollen igen efteråt för att se skillnaden.'
    'Restart now' = 'Vila i hundgården (starta om)'
    'Restart the computer in 30 seconds? Save your work first.' = 'Starta om datorn om 30 sekunder? Spara ditt arbete först.'
    'Test mode: the computer would restart now.' = 'Testläge: datorn skulle ha startats om nu.'
    'The computer restarts in 30 seconds. Run PC Toolkit again afterwards to see the difference.' = 'Datorn startar om om 30 sekunder. Kör Spårkollen igen efteråt för att se skillnaden.'
    'Finish' = 'Fot! – Avsluta'
    'Open report folder' = 'Öppna rapportmappen'
    'Show full log' = 'Förarens anteckningar (hela loggen)'
    'PC Toolkit has closed. You can close this tab.' = 'Spårkollen har stängts. Du kan stänga den här fliken.'
}